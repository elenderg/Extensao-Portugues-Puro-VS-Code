{
  "comments": 
  {
      "lineComment":  { "comment": "\\" }
    , "blockComment": [ "[", "]"        ]
  }
  , "brackets": 
  [
      [ "{", "}" ]
    , [ "[", "]" ]
    , [ "(", ")" ]
    , [ ":", "." ]
  ]
  , "autoClosingPairs": 
  [
      [ "{" , "}"  ]
    , [ "[" , "]"  ]
    , [ "(" , ")"  ]
    , [ "\"", "\"" ]
    , [ "'" , "s"  ]
  ]
  , "surroundingPairs": 
  [
      [ "{" , "}"  ]
    , [ "[" , "]"  ]
    , [ "(" , ")"  ]
    , [ "\"", "\"" ]
    , [ "'" , "'"  ]
  ]
}